{
  "name": "mentorloop",
  "private": true,
  "version": "0.0.0",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @mentorloop/api\" \"npm run dev -w @mentorloop/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:generate": "npm run db:generate -w @mentorloop/api --",
    "db:migrate": "npm run db:migrate -w @mentorloop/api",
    "db:seed": "npm run db:seed -w @mentorloop/api",
    "db:studio": "npm run db:studio -w @mentorloop/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}