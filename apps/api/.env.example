NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://mentorloop:mentorloop@localhost:5433/mentorloop
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Google OAuth (Sprint 2.2). Redirect URI to register in Google Cloud:
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sprint 4.4 match explanations (optional; empty key uses template-only mode)
GROQ_API_KEY=
GROQ_EXPLAIN_MODEL=openai/gpt-oss-20b
GROQ_QUALITY_MODEL=openai/gpt-oss-120b
# Set only when explicitly running the trusted first-admin bootstrap script.
# ADMIN_EMAIL=verified-admin@example.com
